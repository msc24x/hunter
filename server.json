{
    "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
    "name": "io.github.msc24x/hunter",
    "title": "Hunter",
    "description": "Create, manage, and judge coding contests end to end on Hunter.",
    "websiteUrl": "https://hunter.cambo.in",
    "icons": [
        {
            "src": "https://hunter.cambo.in/assets/logo-mid.webp",
            "mimeType": "image/webp",
            "sizes": ["any"]
        }
    ],
    "repository": {
        "url": "https://github.com/msc24x/hunter",
        "source": "github"
    },
    "version": "1.0.0",
    "remotes": [
        {
            "type": "streamable-http",
            "url": "https://hunter.cambo.in/api/mcp",
            "headers": [
                {
                    "name": "Authorization",
                    "description": "Hunter API token. Create one from your account settings.",
                    "isRequired": true,
                    "isSecret": true,
                    "placeholder": "Bearer <your-hunter-api-token>"
                }
            ]
        }
    ]
}
